<resources>
    <!-- Dark parent theme makes the page's prefers-color-scheme follow the phone's dark mode, like Chrome. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#60A5FA</item>
        <item name="android:statusBarColor">#0D1C3B</item>
        <item name="android:navigationBarColor">#0D1C3B</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
